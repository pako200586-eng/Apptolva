rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAnonymousOperator() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.token.email.lower())).data.rol;
    }

    function isPanelUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email is string
        && getUserRole() in ['admin', 'lectura', 'master'];
    }

    function isAdmin() {
      return isPanelUser() && getUserRole() == 'admin';
    }

    // El catálogo solo lo modifica el responsable autorizado (mismo criterio que las operaciones sensibles del panel).
    function isCatalogOwner() {
      return isAdmin() && request.auth.token.email.lower() == 'frank@apptolva.com';
    }

    // Keep evaluation access independent from usuarios/{email}.rol (panel role).
    function isEmailPasswordUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email is string;
    }

    function isPasswordRouteUser() {
      return isEmailPasswordUser()
        && getUserRole() in ['operador', 'master', 'admin', 'lectura'];
    }

    function isRouteUser() {
      return isAnonymousOperator() || isPasswordRouteUser();
    }

    function getEvaluationRole() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.token.email.lower())).data.get('rol_evaluaciones', 'sin_acceso');
    }

    function isEvaluationUser() {
      return isEmailPasswordUser()
        && getEvaluationRole() in ['admin', 'evaluador'];
    }

    function isEvaluationAdmin() {
      return isEmailPasswordUser() && getEvaluationRole() == 'admin';
    }

    function validEvaluation(evaluationId) {
      return request.resource.data.keys().hasOnly([
          'id', 'timestamp', 'fecha', 'aspirante', 'master', 'centro',
          'unidad_neg', 'configuracion', 'motor', 'transmision', 'score',
          'apto', 'tipo', 'fullState', 'creadoPor', 'actualizadoEn'
        ])
        && request.resource.data.id == evaluationId
        && request.resource.data.tipo == 'operador_master'
        && request.resource.data.timestamp is string
        && request.resource.data.fecha is string
        && request.resource.data.aspirante is string
        && request.resource.data.master is string
        && request.resource.data.score is number
        && request.resource.data.apto is bool
        && request.resource.data.fullState is map
        && request.resource.data.creadoPor == request.auth.token.email.lower()
        && request.resource.data.actualizadoEn is string;
    }

    function validDescargaEvaluation(evaluationId) {
      return request.resource.data.keys().hasAll([
          'folio', 'operador', 'fecha', 'granja', 'economico',
          'calificacion', 'resultado', 'observaciones', 'respuestas',
          'evaluador', 'timestamp'
        ])
        && request.resource.data.keys().hasOnly([
          'folio', 'operador', 'fecha', 'granja', 'economico',
          'calificacion', 'resultado', 'observaciones', 'respuestas',
          'evaluador', 'evaluadorEmail', 'timestamp'
        ])
        && request.resource.data.folio == evaluationId
        && request.resource.data.operador is string
        && request.resource.data.fecha is string
        && request.resource.data.granja is string
        && request.resource.data.economico is string
        && request.resource.data.calificacion is number
        && request.resource.data.calificacion >= 0
        && request.resource.data.calificacion <= 100
        && request.resource.data.resultado in ['PENDIENTE', 'APTO (APROBADO)', 'NO APTO']
        && request.resource.data.observaciones is string
        && request.resource.data.respuestas is map
        && request.resource.data.evaluador is string
        && (!request.resource.data.keys().hasAny(['evaluadorEmail'])
          || request.resource.data.evaluadorEmail == request.auth.token.email.lower())
        && request.resource.data.timestamp is string;
    }

    function validConduccionEvaluation(evaluationId) {
      return request.resource.data.keys().hasAll([
          'id', 'creadoPor', 'timestamp', 'fecha', 'aspirante', 'master',
          'centro', 'unidad_neg', 'configuracion', 'motor', 'transmision',
          'score', 'apto', 'fullState'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'tipoEvaluacion', 'creadoPor', 'timestamp', 'fecha',
          'aspirante', 'master', 'centro', 'unidad_neg', 'configuracion',
          'motor', 'transmision', 'score', 'apto', 'fullState'
        ])
        && request.resource.data.id == evaluationId
        && (!request.resource.data.keys().hasAny(['tipoEvaluacion'])
          || request.resource.data.tipoEvaluacion == 'Conducción')
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.timestamp is string
        && request.resource.data.fecha is string
        && request.resource.data.aspirante is string
        && request.resource.data.master is string
        && request.resource.data.centro is string
        && request.resource.data.unidad_neg is string
        && request.resource.data.configuracion is string
        && request.resource.data.motor is string
        && request.resource.data.transmision is string
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100
        && request.resource.data.apto is bool
        && request.resource.data.fullState is map;
    }

    match /sistema/contadores {
      allow read: if signedIn();
      allow delete: if false;

      allow create: if isAdmin()
        || (isRouteUser()
          && (
            (request.resource.data.keys().hasOnly(['folio_bitacora'])
              && request.resource.data.folio_bitacora == 1001)
            || (request.resource.data.keys().hasOnly(['folio_actual'])
              && request.resource.data.folio_actual == 1001)
          ));

      allow update: if isAdmin()
        || (isRouteUser()
          && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['folio_bitacora'])
              && request.resource.data.folio_bitacora is int
              && request.resource.data.folio_bitacora == resource.data.get('folio_bitacora', 1000) + 1)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['folio_actual'])
              && request.resource.data.folio_actual is int
              && request.resource.data.folio_actual == resource.data.get('folio_actual', 1000) + 1)
          ));
    }

    match /bitacoras_087/{folio} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }

    match /bitacora_reports/{reportId} {
      // Los clientes anónimos conservan temporalmente los enlaces QR anteriores.
      allow get: if isAnonymousOperator() || isPanelUser()
        || (isPasswordRouteUser() && resource.data.owner_uid == request.auth.uid);
      allow list: if isPanelUser()
        || (isPasswordRouteUser() && resource.data.owner_uid == request.auth.uid);
      // Checklist: permite create aunque aún no envíe owner_uid (compatibilidad).
      // Bitácora: conserva la protección por owner_uid.
      allow create: if isAdmin()
        || (isAnonymousOperator()
          && (
            request.resource.data.get('report_type', '') == 'checklist'
            || request.resource.data.owner_uid == request.auth.uid
          ))
        || (isPasswordRouteUser() && request.resource.data.owner_uid == request.auth.uid
          && !request.resource.data.keys().hasAny(['folio_definitivo', 'fecha_recepcion_nube'])
          && validPasswordReport(reportId));

      allow update: if isRouteUser()
        && resource.data.owner_uid == request.auth.uid
        && resource.data.get('turnoCerrado', false) != true
        && request.resource.data.owner_uid == resource.data.owner_uid
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.get('auditoria', []).size() >= resource.data.get('auditoria', []).size()
        && (isAnonymousOperator() || (validPasswordReport(reportId)
          && request.resource.data.get('folio_definitivo', null) == resource.data.get('folio_definitivo', null)
          && request.resource.data.get('fecha_recepcion_nube', null) == resource.data.get('fecha_recepcion_nube', null)));
      allow delete: if false;
    }

    function optionalReportString(d, field, maxLength) {
      return !(field in d) || (d[field] is string && d[field].size() <= maxLength);
    }

    function validPasswordReport(reportId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'owner_uid', 'report_type', 'created_at', 'payload'])
        && d.keys().hasOnly([
          'id', 'owner_uid', 'folio', 'folio_provisional', 'report_type', 'unit_id',
          'driver_name', 'employee_number', 'license', 'empresa', 'puntos_intermedios',
          'hora_salida', 'hora_llegada', 'shift_start_hour', 'priority', 'sync_status',
          'payload', 'created_at', 'updated_at', 'synced_at', 'device_id', 'auditoria',
          'turnoCerrado', 'server_created_at', 'server_updated_at', 'folio_definitivo',
          'fecha_recepcion_nube'
        ])
        && d.id == reportId && d.id is string && d.id.size() <= 128
        && d.owner_uid is string && d.owner_uid.size() <= 128
        && d.report_type in ['checklist', 'bitacora']
        && d.created_at is string && d.created_at.size() <= 40
        && d.payload is map && d.payload.size() <= 100
        && optionalReportString(d, 'folio', 128)
        && optionalReportString(d, 'folio_provisional', 128)
        && optionalReportString(d, 'unit_id', 100)
        && optionalReportString(d, 'driver_name', 200)
        && optionalReportString(d, 'employee_number', 40)
        && optionalReportString(d, 'license', 100)
        && optionalReportString(d, 'empresa', 200)
        && optionalReportString(d, 'puntos_intermedios', 2000)
        && optionalReportString(d, 'hora_salida', 40)
        && optionalReportString(d, 'hora_llegada', 40)
        && optionalReportString(d, 'priority', 40)
        && optionalReportString(d, 'sync_status', 40)
        && optionalReportString(d, 'updated_at', 40)
        && optionalReportString(d, 'synced_at', 40)
        && optionalReportString(d, 'device_id', 128)
        && optionalReportString(d, 'folio_definitivo', 128)
        && (!('shift_start_hour' in d) || d.shift_start_hour is number)
        && (!('server_created_at' in d) || d.server_created_at is timestamp)
        && (!('server_updated_at' in d) || d.server_updated_at is timestamp)
        && (!('fecha_recepcion_nube' in d) || d.fecha_recepcion_nube is timestamp)
        && (!('auditoria' in d) || (d.auditoria is list && d.auditoria.size() <= 1000))
        && (!('turnoCerrado' in d) || d.turnoCerrado is bool);
    }

    match /usuarios/{email} {
      allow get: if signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email.lower() == email;
      allow list, create, update, delete: if false;
    }

    match /ordenes_trabajo/{otId} {
      allow read: if isPanelUser();
      allow write: if isAdmin();
    }

    match /ot_seguimiento/{segId} {
      allow read: if isPanelUser();
      allow write: if isAdmin();
    }

    match /ot_por_reporte/{reportId} {
      allow read: if isPanelUser();
      allow write: if isAdmin();
    }

    match /falla_ot_cobertura/{coverageId} {
      allow read: if isPanelUser();
      allow write: if isAdmin();
    }

    function validEquipo(equipoId) {
      let equipo = request.resource.data;
      return equipo.keys().hasAll(['id', 'economico', 'tipo', 'estado'])
        && equipo.keys().hasOnly(['id', 'economico', 'display', 'tipo', 'estado', 'notas', 'updated_at', 'updated_by'])
        && equipo.id == equipoId
        && equipo.tipo in ['tracto', 'tolva', 'dolly', 'utilitaria']
        && equipo.estado in ['activo', 'inactivo', 'siniestrado', 'taller']
        && equipo.economico is string
        && equipo.economico.matches('^[0-9]+$')
        && equipoId == equipo.tipo + '_' + equipo.economico
        && (!equipo.keys().hasAny(['display']) || equipo.display is string)
        && (!equipo.keys().hasAny(['notas']) || equipo.notas is string)
        && (!equipo.keys().hasAny(['updated_at']) || equipo.updated_at is string)
        && (!equipo.keys().hasAny(['updated_by']) || equipo.updated_by is string);
    }

    // Los operadores (anónimos) leen el catálogo para validar el checklist; solo el responsable lo modifica y nunca se borra.
    match /catalogo_equipos/{equipoId} {
      allow read: if signedIn();
      allow create, update: if isCatalogOwner() && validEquipo(equipoId);
      allow delete: if false;
    }

    match /cierres_masivos_ot/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /evaluaciones_operador_master/{evaluationId} {
      allow get, list: if isEvaluationAdmin();
      allow create: if isEvaluationUser() && validEvaluation(evaluationId);
      allow update: if isEvaluationAdmin() && validEvaluation(evaluationId);
      allow delete: if isEvaluationAdmin();
    }

    match /evaluaciones_conduccion/{evaluationId} {
      allow get, list: if isEvaluationUser();
      allow create: if (isAnonymousOperator() || isEvaluationUser())
        && validConduccionEvaluation(evaluationId);
      allow update: if (isAnonymousOperator() || isEvaluationUser())
        && resource.data.creadoPor == request.auth.uid
        && validConduccionEvaluation(evaluationId);
    }

    match /evaluaciones_descarga/{evaluationId} {
      allow get, list: if isEvaluationUser();
      allow create: if isEvaluationUser() && validDescargaEvaluation(evaluationId);
    }

    function validAlertaPush(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'owner_uid', 'unit_id', 'driver_name', 'subscription',
          'fire_at_270', 'fire_at_300', 'sent_270', 'sent_300', 'updated_at'
        ])
        && d.owner_uid == uid
        && d.unit_id is string && d.unit_id.size() <= 60
        && d.driver_name is string && d.driver_name.size() <= 120
        && d.subscription is map
        && d.subscription.keys().hasOnly(['endpoint', 'expirationTime', 'keys'])
        && d.subscription.endpoint is string
        && d.subscription.endpoint.matches('https://.*')
        && d.subscription.endpoint.size() <= 1000
        && d.subscription.keys is map
        && d.subscription.keys.keys().hasOnly(['p256dh', 'auth'])
        && d.subscription.keys.p256dh is string
        && d.subscription.keys.auth is string
        && d.fire_at_270 is number
        && d.fire_at_300 is number
        && d.sent_270 == false
        && d.sent_300 == false
        && d.updated_at is number;
    }

    // Suscripción Web Push del operador en turno de manejo; el servidor (Admin SDK) envía y marca los avisos.
    match /alertas_nom087/{uid} {
      allow get: if isRouteUser() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if isRouteUser()
        && request.auth.uid == uid
        && validAlertaPush(uid);
      allow delete: if isRouteUser() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
